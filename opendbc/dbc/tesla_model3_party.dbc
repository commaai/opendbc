CM_ BO_ 605 "Bytes change when toggling between FSD and AP, as well as Traffic Light and Stop Sign Control in TACC";

CM_ SG_ 659 DAS_autosteerEnabled "1 if Autosteer or FSD is enabled, 0 otherwise";
CM_ SG_ 785 leftBlinkerOn "only describes stalk position if half pressed without auto-cancel blinkers. otherwise acts as expected";
CM_ SG_ 785 rightBlinkerOn "only describes stalk position if half pressed without auto-cancel blinkers. otherwise acts as expected";
CM_ SG_ 785 scrollWheelPressed "captures either scroll wheel left, right or down press";

CM_ BO_ 1161 "Sent by HW3/HW4 Autopilot computers only on firmware with the 3-bit DAS_steeringControlType (not by HW2.5)";
CM_ BO_ 84 "Appears with the 3-bit DAS_steeringControlType firmware on all Autopilot hardware, including HW2.5";
CM_ BO_ 521 "Sent by HW3/HW4 Autopilot computers, not by HW2.5";
CM_ BO_ 2047 "Sent on the party bus by HW3/HW4 cars, not seen on HW2.5";
CM_ SG_ 2047 GTW_dasHw "5 (TESLA_AP4) observed on HW4 cars, not in the source DBC";
CM_ SG_ 880 EPAS3S_driverlessState "Set while the EPS executes an FSD (DAS_steeringControlType 4) request, 3-bit firmware only";
